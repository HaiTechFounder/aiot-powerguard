              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "power_w": {
            "title": "Power W",
            "type": "number"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "telemetry_id": {
            "title": "Telemetry Id",
            "type": "integer"
          },
          "voltage_v": {
            "title": "Voltage V",
            "type": "number"
          }
        },
