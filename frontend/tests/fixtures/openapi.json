          "current_a": {
            "title": "Current A",
            "type": "number"
          },
          "detected_at": {
            "title": "Detected At",
            "type": "string"
          },
          "device_id": {
            "title": "Device Id",
            "type": "string"
          },
          "energy_wh": {
            "title": "Energy Wh",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "model_version": {
