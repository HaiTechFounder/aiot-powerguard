# AIoT PowerGuard backend - local configuration example.
# Copy to .env and fill in real values. .env is Git-ignored.

POWERGUARD_APP_ENV=development
POWERGUARD_LOG_FORMAT=console
POWERGUARD_LOG_LEVEL=INFO

# --- HTTP -------------------------------------------------------------------
POWERGUARD_HTTP_HOST=127.0.0.1
POWERGUARD_HTTP_PORT=8000
# Exact allow-list, comma separated. "*" is rejected.
POWERGUARD_CORS_ORIGINS=http://127.0.0.1:5173

# --- Database ---------------------------------------------------------------
POWERGUARD_DATABASE_URL=sqlite:///./data/powerguard.db
POWERGUARD_SQLITE_BUSY_TIMEOUT_MS=5000

# --- MQTT -------------------------------------------------------------------
# Set to false for API-only development or tests with an injected fake client.
POWERGUARD_MQTT_ENABLED=true
POWERGUARD_MQTT_HOST=127.0.0.1
POWERGUARD_MQTT_PORT=1883
POWERGUARD_MQTT_USERNAME=powerguard-backend
POWERGUARD_MQTT_PASSWORD=change-me
POWERGUARD_MQTT_INSTANCE_ID=local
POWERGUARD_MQTT_KEEPALIVE_S=30
POWERGUARD_MQTT_INGRESS_QUEUE_SIZE=1000
POWERGUARD_MQTT_SHUTDOWN_GRACE_S=10

# --- Device status ----------------------------------------------------------
POWERGUARD_STALE_AFTER_S=15
POWERGUARD_STALE_SCAN_INTERVAL_S=2

# --- WebSocket --------------------------------------------------------------
POWERGUARD_WS_MAX_CONNECTIONS=100
POWERGUARD_WS_QUEUE_SIZE=64
POWERGUARD_WS_PING_INTERVAL_S=20
POWERGUARD_WS_PING_TIMEOUT_S=20

# --- Ingestion bounds -------------------------------------------------------
# These are PROTOCOL INTEGRITY bounds, not safety thresholds. Warning and
# overcurrent policy is a separate concern and is not configured here.
POWERGUARD_MAX_PAYLOAD_BYTES=2048
POWERGUARD_MIN_VOLTAGE_V=0.0
POWERGUARD_MAX_VOLTAGE_V=8.4

# HARDWARE_CONFIGURATION_PENDING.
# Development values derived from the INA226 measurement ceiling
# (81.90 mV / 0.01 ohm = 8.19 A) and the 8.4 V bus. Replace them with
# hardware-validated measurement bounds before hardware acceptance. Do not
# relabel them as safe warning or overcurrent settings.
POWERGUARD_MAX_ABS_CURRENT_A=8.19
POWERGUARD_MAX_ABS_POWER_W=68.8
POWERGUARD_POWER_REL_TOLERANCE=0.05
